# Frontend public base path.
# Root deployment:
# SUB2API_BASE_PATH=/
#
# Sub-path deployment:
# SUB2API_BASE_PATH=/sub2api/
SUB2API_BASE_PATH=/sub2api/

SUB2API_IMAGE_TAG=custom-subpath

SERVER_PORT=8080
BIND_HOST=127.0.0.1
TZ=Asia/Shanghai

POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me
TOTP_ENCRYPTION_KEY=change_me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
